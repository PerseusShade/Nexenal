{
    "global": {
        "ignore": [
            ".git/",
            "node_modules/",
            "target/",
            "dist/",
            "build/",
            "gen/",
            "Output/",
            ".next/",
            ".vercel/",
            ".dart_tool/",
            ".vscode/",
            ".idea/",
            ".local/",

            "__pycache__/",
            "venv/",
            "env/",
            "*.pyc",

            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml",
            "Cargo.lock",
            "Cargo.toml",
            "config.json",
            ".env*",

            "*.exe",
            "*.pdb",
            "*.dll",
            "*.so",
            "*.dylib",
            "*.zip",
            "*.tar.gz",
            "*.7z",

            "*.png",
            "*.jpg",
            "*.jpeg",
            "*.gif",
            "*.svg",
            "*.ico",
            "*.webp",
            "*.mp4",
            "*.mp3",
            "*.pdf"
        ]
    },
    "tree": {
        "default_output": "tree.txt"
    },
    "all": {
        "default_output": "merged_code.txt"
    }
}